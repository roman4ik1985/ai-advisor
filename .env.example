# cli = local testing with the existing Codex login; api = production OpenAI API.
AI_PROVIDER=cli
PORT=8787
HOST=127.0.0.1

# Comma-separated production origins. localhost is always accepted in CLI mode.
ALLOWED_ORIGINS=https://ledprojector.com.ua,https://www.ledprojector.com.ua

# API mode only. Never expose this value in public JavaScript or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# Optional CLI override. Empty means use the model selected by Codex.
CODEX_MODEL=
CODEX_TIMEOUT_MS=90000

STORE_URL=https://ledprojector.com.ua
RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONCURRENT=4
AI_MAX_QUEUE=16
SHUTDOWN_TIMEOUT_MS=30000

# Opt-in local learning log. It stores redacted question/answer pairs for manual review only.
LEARNING_LOG_ENABLED=false
LEARNING_LOG_FILE=ai-advisor-learning.log
